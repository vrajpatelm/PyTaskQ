[TEMPLATE]
# ─── Email Configuration ──────────────────────────────────────────────────────
# Used by the send_email task in src/task_registery.py
#
# If left empty, email tasks run in simulated mode (safe for dev/testing).
EMAIL=
EMAIL_PASSWORD=

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Queue Tuning ─────────────────────────────────────────────────────────────
# Maximum number of tasks allowed in the pending queue before backpressure kicks in.
QUEUE_CAPACITY=500

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Per-tenant request limit per minute. Both the enforcer (429 responses) and
# the reporter (/metrics -> rate_limit_max) read THIS single value.
# Raise it (e.g. 10000) only temporarily for load testing.
RATE_LIMIT_PER_MINUTE=100

# ─── Worker Task Timeout ──────────────────────────────────────────────────────
# Hard wall-clock limit (seconds) for any single task execution. On expiry the
# worker bumps the task's fence token, so a late result from the orphaned
# handler is discarded. Set 0 to disable (not recommended).
TASK_TIMEOUT=300

# ─── Security ─────────────────────────────────────────────────────────────────
# MASTER_KEY: Protects the /admin/keys/create and /admin/keys/revoke endpoints.
# Set to a long random secret. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# In development, leave as * to allow all origins.
# In production, set to your actual frontend URL: https://yourdomain.com
# For multiple origins, comma-separate them: https://app.com,https://admin.app.com
ALLOWED_ORIGINS=*

# ─── Environment ──────────────────────────────────────────────────────────────
# Set to "production" to disable the /docs and /redoc Swagger UI endpoints.
# Leave empty or set to "development" to keep them enabled.
ENVIRONMENT=development

# ─── Load Testing (tests/load/) ───────────────────────────────────────────────
# Used by locustfile.py and benchmark.py — nothing about the target is
# hardcoded in those files.
#   LOADTEST_HOST    : base URL of the API under test
#   LOADTEST_API_KEY : a tenant API key created via POST /admin/keys/create
LOADTEST_HOST=http://localhost:8000
LOADTEST_API_KEY=
