# ─── Email Configuration ─────────────────────────────────────────────────────
# Used by the send_email task in src/task_registery.py
#
# EMAIL       : The Gmail address that sends emails (e.g. yourname@gmail.com)
# EMAIL_PASSWORD : A Gmail App Password (NOT your real Gmail password)
#
# How to create a Gmail App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (required)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Select App: "Mail", Device: "Other (custom name)" → "Distributed-Queue"
#   5. Copy the 16-character password shown and paste it below
#
# If these are left empty, email tasks will run in "simulated" mode
# (no actual email is sent — safe for local development and testing).
EMAIL=
EMAIL_PASSWORD=


REDIS_HOST=localhost
REDIS_PORT=6379
