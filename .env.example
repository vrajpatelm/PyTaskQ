# ─── Redis ────────────────────────────────────────────────────────────────────
# Either a full URL (wins when set) …
#   REDIS_URL=redis://:password@localhost:6379/0
# … or the individual parts:
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Seconds one Redis command may take before its connection counts as dead and is
# reopened (also catches connections a NAT/firewall dropped silently). Keep it
# above 5 (the workers' idle wait adjusts below it).
REDIS_SOCKET_TIMEOUT=15
REDIS_CONNECT_TIMEOUT=5

# Put every PyTaskQ key under "{prefix}:" so several installations (or PyTaskQ
# and your own app) can share one Redis. The same value everywhere; changing it
# later starts from an empty installation. Empty = the original key names.
# REDIS_KEY_PREFIX=shop

# ─── High availability (docs/REDIS.md#high-availability) ──────────────────────
# With Redis Sentinel, list the Sentinels instead of Redis itself: PyTaskQ asks
# them for the current primary and follows failovers. REDIS_PASSWORD (or the
# password and db in REDIS_URL) still apply to Redis.
# REDIS_SENTINELS=sentinel-1:26379,sentinel-2:26379,sentinel-3:26379
# REDIS_SENTINEL_MASTER=mymaster
# REDIS_SENTINEL_PASSWORD=
#
# After queueing a job, wait until this many replicas have it (at most
# REDIS_WAIT_TIMEOUT_MS), so a confirmed job survives losing the primary.
# 0 = don't wait.
REDIS_WAIT_REPLICAS=0
REDIS_WAIT_TIMEOUT_MS=500

# ─── Performance ──────────────────────────────────────────────────────────────
# Settings → Performance in the dashboard tells you which of these to change.
# Full guide: docs/PERFORMANCE.md
#
# REDIS_MAX_CONNECTIONS : Redis connections per API/worker process. When all are
#                         busy, a request waits for one instead of failing.
# REDIS_POOL_TIMEOUT    : seconds to wait for a free connection before a 503.
# WEB_WORKERS           : API processes (`pytaskq dashboard --workers`); 0 = one
#                         per CPU core. Leave at 1 on small servers that also
#                         run a worker.
# LIVE_UPDATES_PER_SECOND : how often open dashboards refresh at most.
REDIS_MAX_CONNECTIONS=200
REDIS_POOL_TIMEOUT=5
WEB_WORKERS=1
LIVE_UPDATES_PER_SECOND=2

# ─── Queue Tuning ─────────────────────────────────────────────────────────────
# How many jobs can wait in EACH queue before new jobs for it sent through the
# API get HTTP 429. Jobs your app queues with .delay() are never refused. 0 = no limit.
QUEUE_CAPACITY=500

# How many queue names may exist. Unused names are forgotten after a few
# minutes. Through the API, a job can only go to a queue that already exists.
MAX_QUEUES=100

# Results larger than this (bytes) aren't stored; the job still succeeds and its
# record explains why. Store big outputs elsewhere and return a link. 0 = no limit.
MAX_RESULT_BYTES=1000000

# Jobs larger than this (bytes, their arguments as JSON) are refused: the API
# answers 413 and .delay() raises ValueError. 0 = no limit.
MAX_PAYLOAD_BYTES=1000000

# Dead letters kept; beyond this the oldest are dropped. 0 = no limit.
DLQ_LIMIT=10000

# ─── Queues & schedules (docs/QUEUES.md) ──────────────────────────────────────
# Queues a worker serves, comma-separated. Empty = the queues of the worker's own
# tasks (recommended). Same as `pytaskq worker --queues images,default`.
# Set it per worker, not in a .env shared by every worker.
# WORKER_QUEUES=
#
# Time zone cron schedules are read in, unless a task sets tz=. IANA names:
# UTC, Europe/London, America/New_York, Asia/Kolkata…
CRON_TIMEZONE=UTC
#
# When no worker was running at a scheduled time, run the latest missed tick
# once when workers are back (a task's catch_up= wins). Missed runs are always
# logged and shown in Settings → Performance.
CRON_CATCH_UP=true
#
# How a worker shares its turns between high, default and low jobs while all
# have work waiting: 6,3,1 = 6 high, 3 default, 1 low of every 10. "strict" =
# every high job first (low ones can then wait forever). Same value everywhere.
PRIORITY_WEIGHTS=6,3,1

# ─── Idempotency ──────────────────────────────────────────────────────────────
# A job sent with an Idempotency-Key header (or `task.delay(..., idempotency_key=…)`)
# is queued once; repeats with the same key return the original job for this
# many seconds. Lets clients retry safely after a timeout, 429 or 503.
IDEMPOTENCY_TTL=86400

# ─── Worker Task Timeout ──────────────────────────────────────────────────────
# Default limit (seconds) for one attempt of a task, counted from when it starts
# (not while it waits for a free process/thread). A CPU task's process is stopped,
# an async task is cancelled; an IO thread can't be stopped, so its late result is
# ignored. See docs/WORKERS.md. Set 0 to disable (not recommended).
TASK_TIMEOUT=300

# ─── Task Defaults & History ──────────────────────────────────────────────────
# MAX_RETRIES        : retries before a job is dead-lettered (per-task `max_retries=` wins)
# RESULT_TTL         : seconds a FINISHED job's status/result is kept (waiting jobs never expire)
# FINISHED_JOBS_KEPT : at most this many finished jobs are kept, the oldest go first, so
#                      Redis memory stays flat however busy you are (about 1–3 KB each).
#                      The History tab searches them. 0 = no cap (only RESULT_TTL).
# HISTORY_LIMIT      : how many recent jobs the dashboard's Jobs tab can list
MAX_RETRIES=3
# A failed job's error text is cut to this many bytes (start and end kept).
MAX_ERROR_BYTES=4096
RESULT_TTL=86400
FINISHED_JOBS_KEPT=50000
HISTORY_LIMIT=500

# ─── Worker Sizing (optional; CLI flags --cpu-workers/--io-workers also work) ──
# Default: CPU processes = cores - 1, IO threads = cores x 4 (at least 4).
# Raise WORKER_IO_WORKERS for jobs that mostly wait (HTTP calls, email, async).
# WORKER_CPU_WORKERS=4
# WORKER_IO_WORKERS=32
# WORKER_RESERVED_CORES=1

# ─── Worker behaviour (docs/WORKERS.md) ───────────────────────────────────────
# Seconds running jobs get to finish on Ctrl+C / docker stop; jobs still running
# after that go back on their queue. (Docker: set stop_grace_period above it.)
WORKER_SHUTDOWN_GRACE=30
# Seconds without a heartbeat before a worker counts as dead and its jobs are
# put back on their queues.
WORKER_HEARTBEAT_TTL=30
# A stable, unique name per worker ("{hostname}" = this machine's name). With a
# name, a restarted worker puts back the jobs it was running at once. Set it per
# worker (or use {hostname} in Docker), not one fixed name in a shared .env.
# WORKER_NAME={hostname}

# ─── Webhooks & Tracing ───────────────────────────────────────────────────────
# WEBHOOK_SECRET signs webhook bodies (X-PyTaskQ-Signature: sha256=<hmac>).
WEBHOOK_SECRET=
# Tracing (OpenTelemetry) is off unless an OTLP gRPC endpoint is set. One trace
# follows each job from the request that queued it through every attempt.
# Needs `pip install "pytaskq[tracing]"` (already in the Docker image).
# http:// endpoints are plain text (a local Jaeger); https:// uses TLS.
# The dev docker-compose.yml sets Jaeger's: open http://localhost:16686.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=my-workers          # defaults to pytaskq-api / pytaskq-worker
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_KEY

# ─── Sign-in & accounts (self-hosting) ────────────────────────────────────────
# Sign-in is ON by default. On first start the server log prints a one-time
# setup code; open the dashboard and enter it to create the admin account.
# Lost it? Run:  pytaskq users setup-code
#
# PYTASKQ_AUTH=off      disables sign-in entirely. Local development only!
# SESSION_TTL_DAYS      how long a dashboard sign-in lasts
# COOKIE_SECURE         auto | true | false. "auto" marks the cookie Secure when
#                       the request arrived over HTTPS (or X-Forwarded-Proto: https)
PYTASKQ_AUTH=on
SESSION_TTL_DAYS=30
COOKIE_SECURE=auto

# Optional: create the first admin automatically (headless installs) instead of
# using the setup code. Ignored once any account exists. Remove after first start.
PYTASKQ_ADMIN_USER=
PYTASKQ_ADMIN_PASSWORD=

# Optional: a Bearer key with admin rights for automation that can't use a
# personal API token. Must be at least 16 characters; empty = disabled.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Only matters for browser code on OTHER websites calling this API; the
# dashboard is same-origin. With *, other sites can call it with an API token,
# never with a signed-in visitor's cookie. List exact origins (comma-separated)
# to let those sites use cookies: https://app.com,https://admin.app.com
ALLOWED_ORIGINS=*

# ─── Environment ──────────────────────────────────────────────────────────────
# Set to "production" to disable the /docs and /redoc Swagger UI endpoints.
# Leave empty or set to "development" to keep them enabled.
ENVIRONMENT=development
