# ─── Redis ────────────────────────────────────────────────────────────────────
# Either a full URL (wins when set) …
#   REDIS_URL=redis://:password@localhost:6379/0
# … or the individual parts:
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ─── Performance ──────────────────────────────────────────────────────────────
# Settings → Performance in the dashboard tells you which of these to change.
# Full guide: docs/PERFORMANCE.md
#
# REDIS_MAX_CONNECTIONS : Redis connections per API/worker process. When all are
#                         busy, a request waits for one instead of failing.
# REDIS_POOL_TIMEOUT    : seconds to wait for a free connection before a 503.
# WEB_WORKERS           : API processes (`pytaskq dashboard --workers`); 0 = one
#                         per CPU core. Leave at 1 on small servers that also
#                         run a worker.
# LIVE_UPDATES_PER_SECOND : how often open dashboards refresh at most.
REDIS_MAX_CONNECTIONS=200
REDIS_POOL_TIMEOUT=5
WEB_WORKERS=1
LIVE_UPDATES_PER_SECOND=2

# ─── Queue Tuning ─────────────────────────────────────────────────────────────
# How many jobs can wait in EACH queue before new jobs for it get HTTP 429.
QUEUE_CAPACITY=500

# Results larger than this (bytes) aren't stored; the job still succeeds and its
# record explains why. Store big outputs elsewhere and return a link. 0 = no limit.
MAX_RESULT_BYTES=1000000

# ─── Queues & schedules (docs/QUEUES.md) ──────────────────────────────────────
# Queues a worker serves, comma-separated. Empty = the queues of the worker's own
# tasks (recommended). Same as `pytaskq worker --queues images,default`.
# Set it per worker, not in a .env shared by every worker.
# WORKER_QUEUES=
#
# Time zone cron schedules are read in, unless a task sets tz=. IANA names:
# UTC, Europe/London, America/New_York, Asia/Kolkata…
CRON_TIMEZONE=UTC

# ─── Idempotency ──────────────────────────────────────────────────────────────
# A job sent with an Idempotency-Key header (or `task.delay(..., idempotency_key=…)`)
# is queued once; repeats with the same key return the original job for this
# many seconds. Lets clients retry safely after a timeout, 429 or 503.
IDEMPOTENCY_TTL=86400

# ─── Worker Task Timeout ──────────────────────────────────────────────────────
# Hard wall-clock limit (seconds) for any single task execution. On expiry the
# worker bumps the task's fence token, so a late result from the orphaned
# handler is discarded. Set 0 to disable (not recommended).
TASK_TIMEOUT=300

# ─── Task Defaults & History ──────────────────────────────────────────────────
# MAX_RETRIES   : retries before a job is dead-lettered (per-task `max_retries=` wins)
# RESULT_TTL    : seconds a job's status/result is kept in Redis
# HISTORY_LIMIT : how many recent jobs the dashboard's Jobs tab can list
MAX_RETRIES=3
RESULT_TTL=86400
HISTORY_LIMIT=500

# ─── Worker Sizing (optional; CLI flags --cpu-workers/--io-workers also work) ──
# Default: CPU processes = cores - 1, IO threads = cores x 4 (at least 4).
# Raise WORKER_IO_WORKERS for jobs that mostly wait (HTTP calls, email, async).
# WORKER_CPU_WORKERS=4
# WORKER_IO_WORKERS=32
# WORKER_RESERVED_CORES=1

# ─── Webhooks & Tracing ───────────────────────────────────────────────────────
# WEBHOOK_SECRET signs webhook bodies (X-PyTaskQ-Signature: sha256=<hmac>).
WEBHOOK_SECRET=
# Tracing (OpenTelemetry) is off unless an OTLP gRPC endpoint is set. One trace
# follows each job from the request that queued it through every attempt.
# Needs `pip install "pytaskq[tracing]"` (already in the Docker image).
# http:// endpoints are plain text (a local Jaeger); https:// uses TLS.
# The dev docker-compose.yml sets Jaeger's: open http://localhost:16686.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=my-workers          # defaults to pytaskq-api / pytaskq-worker
# OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=YOUR_KEY

# ─── Sign-in & accounts (self-hosting) ────────────────────────────────────────
# Sign-in is ON by default. On first start the server log prints a one-time
# setup code; open the dashboard and enter it to create the admin account.
# Lost it? Run:  pytaskq users setup-code
#
# PYTASKQ_AUTH=off      disables sign-in entirely. Local development only!
# SESSION_TTL_DAYS      how long a dashboard sign-in lasts
# COOKIE_SECURE         auto | true | false. "auto" marks the cookie Secure when
#                       the request arrived over HTTPS (or X-Forwarded-Proto: https)
PYTASKQ_AUTH=on
SESSION_TTL_DAYS=30
COOKIE_SECURE=auto

# Optional: create the first admin automatically (headless installs) instead of
# using the setup code. Ignored once any account exists. Remove after first start.
PYTASKQ_ADMIN_USER=
PYTASKQ_ADMIN_PASSWORD=

# Optional: a Bearer key with admin rights for automation that can't use a
# personal API token. Must be at least 16 characters; empty = disabled.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
MASTER_KEY=

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Only matters for browser code on OTHER websites calling this API; the
# dashboard is same-origin. With *, other sites can call it with an API token,
# never with a signed-in visitor's cookie. List exact origins (comma-separated)
# to let those sites use cookies: https://app.com,https://admin.app.com
ALLOWED_ORIGINS=*

# ─── Environment ──────────────────────────────────────────────────────────────
# Set to "production" to disable the /docs and /redoc Swagger UI endpoints.
# Leave empty or set to "development" to keep them enabled.
ENVIRONMENT=development

