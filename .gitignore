# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
venv/
ENV/
env/

# Environment variables (sensitive data)
.env

# Testing / Coverage
.pytest_cache/
.coverage
htmlcov/
*.log

# Operating System files
.DS_Store
Thumbs.db
desktop.ini

# IDEs/Editors
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.agents/
.freebuff/

# Redis dump
dump.rdb

# Local-only files (kept on your machine, never committed)
install.cmd
docs/INTERVIEW_PREP.md
docs/PYTASKQ_ARCHITECTURE_ANALYSIS.md
Claude outputs/

# Python packaging output
dist/
build/
*.egg-info/

# Production deployment: your settings and backups never go in git
deploy/.env
deploy/backups/

# Load-test output (locust --html / --csv)
report-*.html
run-*.html
*_stats.csv
*_stats_history.csv
*_failures.csv
*_exceptions.csv
