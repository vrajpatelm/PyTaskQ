# ─── PyTaskQ production settings ─────────────────────────────────────────────
# Copy to .env next to docker-compose.prod.yml and fill in the first two lines.

# Your domain. Create a DNS A (and/or AAAA) record pointing it at this server.
PYTASKQ_DOMAIN=pytaskq.example.com

# Long random password that only PyTaskQ uses to talk to Redis. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_PASSWORD=

# Most memory Redis may use. Keep it well below this server's RAM (on a 1 GB
# server, 300mb; on 4 GB, 1500mb). When it's full, new jobs get 503 and every
# existing job is kept; Settings → Performance warns from 90 %.
REDIS_MAXMEMORY=400mb

# Image version to run. Pin it (e.g. 0.6.0) so upgrades happen when you choose.
# Upgrading from 0.3.x? Read docs/UPGRADING.md first.
PYTASKQ_VERSION=latest

# Which tasks the worker runs. The image ships with example_app:queue; for your
# own tasks build a worker image (see docs/DEPLOYMENT.md) and set WORKER_IMAGE.
PYTASKQ_WORKER_APP=example_app:queue
# WORKER_IMAGE=ghcr.io/you/your-app-worker:1.0

# First admin account (optional). Leave empty to use the setup code printed in:
#   docker compose -f docker-compose.prod.yml logs web | grep -A4 "setup code"
PYTASKQ_ADMIN_USER=
PYTASKQ_ADMIN_PASSWORD=

# Backups: a full snapshot every N hours into ./backups, keeping the newest K.
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28

# Performance (optional). The dashboard's Settings → Performance suggests values;
# docs/PERFORMANCE.md explains each one.
# WORKER_IO_WORKERS=32        # jobs each worker runs at once (I/O and async tasks)
# QUEUE_CAPACITY=500          # jobs that can wait before new ones get HTTP 429
# WEB_WORKERS=1               # API processes; 0 = one per CPU core
# REDIS_MAX_CONNECTIONS=200   # Redis connections per process
# FINISHED_JOBS_KEPT=50000    # finished jobs kept (the oldest go first); keeps Redis memory flat
# PRIORITY_WEIGHTS=6,3,1      # share of high/default/low jobs; "strict" = high always first

# Several installations on one Redis? Give each its own prefix (set it before the first start).
# REDIS_KEY_PREFIX=shop

# Monitoring: scrape https://$PYTASKQ_DOMAIN/metrics/prometheus with a viewer's API token
# (docs/DEPLOYMENT.md#monitoring).
